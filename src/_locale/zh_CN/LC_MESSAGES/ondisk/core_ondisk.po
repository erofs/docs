msgid "`EROFS_FEATURE_COMPAT_SB_CHKSUM`"
msgstr "`EROFS_FEATURE_COMPAT_SB_CHKSUM`"

#: ../../src/ondisk/core_ondisk.md 46edb92234f64f30af4a4bb64e05520f
msgid "Superblock CRC32-C checksum is present; see {ref}`superblock-checksum`"
msgstr "存在 superblock CRC32-C checksum；参见 {ref}`superblock-checksum`"

